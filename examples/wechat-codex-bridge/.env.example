# 服务监听端口
PORT=3000

# 微信公众平台里填写的 URL 路径
WECHAT_PATH=/wechat

# 微信后台配置的 Token，必须与后台一致
WECHAT_TOKEN=replace-with-your-wechat-token

# OpenAI API Key
OPENAI_API_KEY=sk-xxxxxxxx

# 默认使用较便宜的 Codex 模型，可按需改成 gpt-5.1-codex 或其他模型
OPENAI_MODEL=gpt-5.1-codex-mini

# 微信被动回复通常要求尽快返回，这里把超时压低一些
OPENAI_TIMEOUT_MS=4500

# 控制回复长度，避免微信里太长
OPENAI_MAX_OUTPUT_TOKENS=600

# 如需显式设置推理强度，可填 low / medium / high；留空则不发送该参数
OPENAI_REASONING_EFFORT=

# 可按需自定义系统提示词
SYSTEM_PROMPT=你是接入微信的 Codex 助手，请默认使用简体中文，回答尽量简洁、直接、可执行。
