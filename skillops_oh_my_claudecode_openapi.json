{
  "openapi": "3.1.0",
  "info": {
    "title": "SkillOps OpenAI Actions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://your-skillops-api.example.com"
    }
  ],
  "paths": {
    "/run/skill_plan_workflow": {
      "post": {
        "operationId": "run_skill_plan_workflow",
        "summary": "Workflow Planner",
        "description": "Decompose task and build execution plan.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "goal": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skill execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "steps": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/run/skill_generate_report": {
      "post": {
        "operationId": "run_skill_generate_report",
        "summary": "Report Writer",
        "description": "Generate structured report with citations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "outline": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skill execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "document_path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/run/skill_platform_deploy": {
      "post": {
        "operationId": "run_skill_platform_deploy",
        "summary": "Platform Adapter",
        "description": "Map skill plan to OpenAI/MCP/Copilot/Bedrock adapters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skill execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}